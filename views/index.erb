<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>メモ一覧</title>
    <link rel="stylesheet" href="http://localhost:4567/style.css">
  </head>
  <body>
    <div class="flex justify-space-between align-end mb-16px" >
      <h1>メモアプリ</h1>
      <a href="http://localhost:4567/memos/new" class="btn-link border-black border-radius px-16px py-8px">追加</a>
    </div>
    <div>
      <ul class="pl-16px line-style-inside">
        <% if @memos %>
          <% @memos.each do |memo| %>
            <li>
              <a href="http://localhost:4567/memos/<%= h memo['id'] %>"><%= h memo['title'] %></a>
            </li>
          <% end %>
        <% end %>
      </ul>
    </div>
  </body>
</html>
